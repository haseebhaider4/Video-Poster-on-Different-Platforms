# Copy this file to ".env" and fill in the keys for the platforms you use.
# Leave a platform's keys empty to hide it. See README.md for step-by-step setup.

PORT=3000

# A public HTTPS address that forwards to this app (ngrok or Cloudflare Tunnel).
# Required for TikTok (it only accepts https sign-in redirects).
# Optional for Instagram (used as a fallback upload method).
# Example: PUBLIC_URL=https://your-name.ngrok-free.app
PUBLIC_URL=

# YouTube — Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — developers.tiktok.com > your app (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Facebook Pages + Instagram Reels — developers.facebook.com > your app
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0
